<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Neighbourhood Circles · CircleShare</title>
  <link rel="stylesheet" href="styles.css" />
</head>

<body>

<!-- HEADER -->
<header class="top-header">
  <div class="header-inner">
    <div class="logo">CircleShare</div>

    <div class="header-right">
      <a href="dashboard.html" class="small-arrow">→</a>
      <a id="logoutBtn" class="logout-link">Logout</a>
    </div>
  </div>
</header>

<style>
.top-header {
  background:#fff;
  border-bottom:1px solid #ddd;
}
.header-inner {
  max-width:600px;
  margin:0 auto;
  padding:0.8rem 1rem;
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.small-arrow, .logout-link {
  font-size:0.85rem;
  color:#333;
  text-decoration:none;
  margin-left:0.6rem;
}
.header-right {
  display:flex;
  align-items:center;
}
.small-arrow:hover, .logout-link:hover { text-decoration:underline; }
</style>

<script>
document.getElementById("logoutBtn")?.addEventListener("click", () => {
  localStorage.removeItem("logged_in");
  window.location.href = "index.html";
});
</script>

<main class="page" style="padding-top:1rem;">

  <h1 class="section-title">Neighbourhood Circles</h1>

  <p style="font-size:0.9rem; color:#555; margin-bottom:1.4rem;">
    Join a circle based on where you live.  
    These circles help neighbours coordinate borrowing, shared assets, and 
    local support with simple norms of trust and care.
  </p>

  <!-- Neighbourhood list -->
  <div style="display:flex; flex-direction:column; gap:1rem;">

    <div class="card">
      <h3>Quadra Village</h3>
      <p style="font-size:0.88rem; color:#555;">42 members • Victoria, BC</p>
      <a class="btn btn-primary" href="circle_view.html?circle=Quadra Village">View / Join</a>
    </div>

    <div class="card">
      <h3>North Park</h3>
      <p style="font-size:0.88rem; color:#555;">31 members</p>
      <a class="btn btn-primary" href="circle_view.html?circle=North Park">View / Join</a>
    </div>

    <div class="card">
      <h3>Fernwood</h3>
      <p style="font-size:0.88rem; color:#555;">29 members</p>
      <a class="btn btn-primary" href="circle_view.html?circle=Fernwood">View / Join</a>
    </div>

    <div class="card">
      <h3>Downtown</h3>
      <p style="font-size:0.88rem; color:#555;">18 members</p>
      <a class="btn btn-primary" href="circle_view.html?circle=Downtown">View / Join</a>
    </div>

  </div>

  <h2 style="font-size:1rem; margin-top:2rem; margin-bottom:0.5rem;">Don’t see your neighbourhood?</h2>
  <a class="btn btn-ghost" href="circle_create_neighbour.html">Create Neighbourhood Circle</a>

</main>

<!-- FOOTER NAV -->
<footer>
  <div class="footer-nav">
    <a href="dashboard.html">Home</a>
    <a href="circles.html">Circles</a>
    <a href="library.html">Borrow/Lend</a>
    <a href="free.html">Give/Receive</a>
    <a href="info.html">Info</a>
  </div>
</footer>

</body>
</html>
